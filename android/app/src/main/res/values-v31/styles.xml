<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- (3.37.0) Android 12 and newer: the phone's own start screen in the start screen's navy, without an icon (the app's start
         screen – screens/splash.dart – follows at once with the Rachana mark). The rest as in values/styles.xml. -->
    <style name="LaunchTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_navy</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>
    <style name="NormalTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
